#!/usr/bin/env python3
import os
import subprocess

print(f'{"No":4}| {"Interface":20} | {"IP":15} | {"Type":5}')
print("----+----------------------+-----------------+------")

count = 1
for interface in os.listdir("/sys/class/net/"):
    if interface == "lo":
        continue

    # Check for Wifi
    if interface in subprocess.getoutput(f"iw dev {interface} info 2>/dev/null"):
        ifacetype = "Wifi"
    # Check for VLAN
    elif subprocess.getoutput(
        f"ip -d a show {interface} | grep vlan | awk '{{print $1\" \"$4\" \"$5}}'"
    ):
        vlan_info = subprocess.getoutput(
            f"ip -d a show {interface} | grep vlan | tr vlan Vlan | awk '{{print $1\"-\"$4\" (\"$5\")\"}}'"
        ).rstrip()
        parent_if = subprocess.getoutput(
            f"ip -d a show {interface} | grep @ | cut -d@ -f2 | cut -d: -f1"
        ).rstrip()
        ifacetype = f"{vlan_info} on {parent_if}"
    else:
        ifacetype = "Lan"

    # Get IP Address
    ip_output = subprocess.getoutput(f"ip addr show {interface}")
    if len(ip_output.split("inet ")) > 1:
        ip = ip_output.split("inet ")[1].split(" ")[0]
        print(f"{count:4}| {interface:20} | {ip:15} | {ifacetype:5}")
    else:
        print(f"{count:4}| {interface:20} | {'-':15} | {ifacetype:5}")

    count += 1
